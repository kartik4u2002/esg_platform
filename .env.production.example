# ─── Domain & SSL ──────────────────────────────────────────────────
DOMAIN_NAME=esg.yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# ─── Django Config ────────────────────────────────────────────────
DJANGO_SECRET_KEY=generate-a-secure-64-character-string-here
DJANGO_SETTINGS_MODULE=config.settings.production
ALLOWED_HOSTS=esg.yourdomain.com
CORS_ALLOWED_ORIGINS=https://esg.yourdomain.com

# ─── Database Config ──────────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
POSTGRES_DB=esg_platform_prod
POSTGRES_USER=esg_prod_user
POSTGRES_PASSWORD=use-a-strong-password-here

# ─── Celery & Redis ───────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# ─── Travel API ───────────────────────────────────────────────────
TRAVEL_API_URL=http://web:8000/api/mock/travel-feed/
