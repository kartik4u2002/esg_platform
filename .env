# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.development

# Database — use 'db' hostname (Docker service name), not 'localhost'
DATABASE_URL=postgresql://esg_user:esg_password@db:5432/esg_platform

# Redis / Celery — use 'redis' hostname (Docker service name)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Travel API — use 'web' hostname (Docker service name)
TRAVEL_API_URL=http://web:8000/api/mock/travel-feed/

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173